        "@types/react": "latest",
        "@types/react-dom": "latest",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.12.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.9.9",
        "typescript": "latest",
        "vite": "^8.3.3",
        "vitest": "^5.0.3"
    }
